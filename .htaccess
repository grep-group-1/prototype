# Premium Fintech Platform - Root Apache Configuration
# This file redirects all requests to the public/ directory.
# 
# If your XAMPP setup doesn't support this, place the project
# so that public/index.php is directly accessible and adjust
# the base_url in config/app.php accordingly.

<IfModule mod_rewrite.c>
    RewriteEngine On
    
    # Redirect all requests to public/ directory
    RewriteRule ^$ public/ [L]
    RewriteRule ((?s).*) public/$1 [L]
</IfModule>

# Security: Deny access to sensitive files
<FilesMatch "\.(env|sql|log|md)$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order deny,allow
        Deny from all
    </IfModule>
</FilesMatch>
